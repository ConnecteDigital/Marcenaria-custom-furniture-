---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';

interface Props {
  message?: string;
  size?: 'md' | 'lg';
  // Botão de ligar em vermelho (usado no topo da página)
  callRed?: boolean;
}

const { message, size = 'lg', callRed = false } = Astro.props;
---

<div class="cta-buttons">
  <a class={`btn btn-wa btn-${size}`} href={whatsappUrl(message)} target="_blank" rel="noopener">
    <Icon name="whatsapp" size={22} /> Pedir orçamento no WhatsApp
  </a>
  <a class:list={['btn btn-call', `btn-${size}`, { 'btn-red': callRed }]} href={site.tel}>
    <Icon name="phone" size={20} /> Ligar {site.phoneDisplay}
  </a>
</div>
