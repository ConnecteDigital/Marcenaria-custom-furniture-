---
import CtaButtons from './CtaButtons.astro';

interface Props {
  title?: string;
  text?: string;
  message?: string;
}

const {
  title = 'Vamos planejar o seu móvel?',
  text = 'Mande uma mensagem com fotos ou medidas do ambiente e conte o que você precisa.',
  message,
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <CtaButtons message={message} />
  </div>
</section>
