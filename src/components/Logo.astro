---
// "icone": desenho da casa + nome em texto (cabeçalho). "completo": logo inteiro (rodapé).
import { Image } from 'astro:assets';
import icone from '../assets/logo-icone.png';
import completo from '../assets/logo-completo.png';
import { site } from '../data/site';

interface Props {
  variant?: 'icone' | 'completo';
}

const { variant = 'icone' } = Astro.props;
---

{
  variant === 'completo' ? (
    <Image class="logo-completo" src={completo} alt={site.name} widths={[240, 480]} sizes="240px" />
  ) : (
    <span class="logo">
      <Image class="logo-mark" src={icone} alt="" widths={[80, 160]} sizes="80px" loading="eager" />
      <span class="logo-text">
        <strong>Marcenaria</strong>
        <span>Custom Furniture</span>
      </span>
    </span>
  )
}
