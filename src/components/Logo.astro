---
// Logotipo em texto até o cliente enviar o logo oficial.
import { site } from '../data/site';
---

<span class="logo" aria-label={site.name}>
  <svg class="logo-mark" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <rect x="1" y="1" width="38" height="38" rx="9" fill="currentColor" opacity=".14" />
    <path d="M11 10h18v20H11z M20 10v20 M17 17v5 M23 17v5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
  </svg>
  <span class="logo-text"><small>Marcenaria</small>Custom Furniture</span>
</span>
