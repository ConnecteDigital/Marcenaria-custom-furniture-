---
// "icone": selo redondo + nome em texto (cabeçalho). "completo": só o selo, grande (rodapé).
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';

interface Props {
  variant?: 'icone' | 'completo';
}

const { variant = 'icone' } = Astro.props;
---

{
  variant === 'completo' ? (
    <Image class="logo-completo" src={logo} alt={site.name} widths={[200, 400]} sizes="200px" />
  ) : (
    <span class="logo">
      <Image class="logo-mark" src={logo} alt="" widths={[60, 120]} sizes="60px" loading="eager" />
      <span class="logo-text">
        <strong>Marcenaria</strong>
        <span>Custom Furniture</span>
      </span>
    </span>
  )
}
