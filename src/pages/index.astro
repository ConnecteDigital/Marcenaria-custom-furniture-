---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { fotoDoServico, fotosDosAmbientes } from '../data/fotos';
import { site, whatsappUrl } from '../data/site';
import { servicos } from '../data/servicos';
import { faqSchema } from '../data/schema';

const faq = [
  {
    q: 'Como peço um orçamento?',
    a: `Chame no WhatsApp ${site.phoneDisplay} ou ligue. Conte o que você precisa e, se puder, mande fotos e medidas do ambiente ou do móvel.`,
  },
  {
    q: 'Vocês fazem o projeto dos móveis planejados?',
    a: 'Sim. Fazemos o projeto, o planejamento e a execução: do desenho do ambiente até a montagem dos móveis no local.',
  },
  {
    q: 'Vocês consertam móveis planejados danificados?',
    a: 'Sim. Consertamos portas, gavetas, dobradiças, corrediças e peças danificadas de móveis planejados.',
  },
  {
    q: 'Fazem móveis que não são planejados?',
    a: 'Sim. Também fabricamos móveis em geral, como mesas, estantes, painéis, balcões e camas.',
  },
  {
    q: 'Atendem imobiliárias?',
    a: 'Sim. Fazemos a manutenção dos móveis de imóveis para entrega, atendendo imobiliárias, proprietários e inquilinos.',
  },
];

const fotoTopo = fotoDoServico('moveis-planejados');
const galeria = fotosDosAmbientes();
const fotoImobiliaria = fotoDoServico('manutencao-imobiliaria');
const msgImobiliaria = servicos.find((s) => s.slug === 'manutencao-imobiliaria')?.mensagem;
---

<Base
  title={`Móveis Planejados em ${site.city} | ${site.name}`}
  description={site.description}
  schema={[faqSchema(faq)]}
>
  <section class="hero hero-home">
    {
      fotoTopo && (
        <Image
          class="hero-bg"
          src={fotoTopo.src}
          alt=""
          widths={[480, 800, 1200, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="container hero-center">
      <span class="eyebrow">Marcenaria em {site.city} e região</span>
      <h1>Móveis planejados sob medida, <em>do projeto à execução</em></h1>
      <p class="hero-lead">Projetamos, fabricamos, consertamos e fazemos a manutenção dos seus móveis.</p>
      <CtaButtons callRed />
      <ul class="hero-badges">
        <li><Icon name="ruler" size={22} /> <span>Projeto sob medida</span></li>
        <li><Icon name="saw" size={22} /> <span>Fabricação</span></li>
        <li><Icon name="wrench" size={22} /> <span>Conserto e manutenção</span></li>
      </ul>
    </div>
  </section>

  <section class="section section-soft" id="servicos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>O que a {site.name} faz por você</h2>
        <p>Do móvel novo, planejado para o seu espaço, ao reparo do móvel que já está na sua casa.</p>
      </div>
      <div class="services-grid">
        {
          servicos.map((s) => {
            const foto = fotoDoServico(s.slug);
            return (
              <article class="service-card">
                {foto ? (
                  <span class="service-photo">
                    <Image src={foto.src} alt={foto.alt} widths={[320, 480, 640]} sizes="(max-width: 600px) 100vw, 360px" />
                  </span>
                ) : (
                  <span class="service-photo service-photo-empty">
                    <Icon name={s.icon} size={64} />
                  </span>
                )}
                <span class="service-icon"><Icon name={s.icon} size={26} /></span>
                <h3>{s.nome}</h3>
                <p>{s.resumo}</p>
                <a class="btn btn-wa btn-md service-cta" href={whatsappUrl(s.mensagem)} target="_blank" rel="noopener">
                  <Icon name="whatsapp" size={20} /> Pedir orçamento
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  {
    galeria.length > 0 && (
      <section class="section" id="ambientes">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Ambientes</span>
            <h2>Móveis planejados para cada canto da casa</h2>
            <p>Cozinhas, closets, salas, quartos, banheiros e home office feitos sob medida.</p>
          </div>
          <div class="gallery">
            {galeria.map((a) => (
              <figure class="gallery-item">
                <Image src={a.src} alt={a.alt} widths={[360, 540, 720]} sizes="(max-width: 700px) 50vw, 380px" />
                <figcaption>{a.legenda}</figcaption>
              </figure>
            ))}
          </div>
          <p class="gallery-note">Imagens ilustrativas.</p>
        </div>
      </section>
    )
  }

  <section class="section section-dark" id="como-trabalhamos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como trabalhamos</span>
        <h2>Projeto, planejamento e execução</h2>
        <p>Você acompanha cada etapa, da primeira conversa ao móvel montado.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <h3>Conversa</h3>
          <p>Você chama no WhatsApp, conta o que precisa e manda fotos ou medidas do ambiente.</p>
        </div>
        <div class="step-card">
          <h3>Projeto</h3>
          <p>Medimos o espaço e desenhamos os móveis do jeito que você imaginou.</p>
        </div>
        <div class="step-card">
          <h3>Planejamento</h3>
          <p>Definimos com você materiais, cores, acabamentos e cada detalhe do móvel.</p>
        </div>
        <div class="step-card">
          <h3>Execução</h3>
          <p>Fabricamos e montamos os móveis no local, com acabamento caprichado.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="imobiliarias">
    <div class="container about-grid">
      {
        fotoImobiliaria ? (
          <div class="about-photo">
            <Image src={fotoImobiliaria.src} alt={fotoImobiliaria.alt} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 460px" />
          </div>
        ) : (
          <div class="about-photo service-photo-empty">
            <Icon name="key" size={96} />
          </div>
        )
      }
      <div>
        <div class="section-head">
          <span class="eyebrow">Imobiliárias e proprietários</span>
          <h2>Manutenção em móveis para entrega de imóvel</h2>
          <p>Deixamos os móveis planejados do imóvel prontos para a vistoria e a entrega das chaves.</p>
        </div>
        <ul class="checklist">
          <li><Icon name="check" size={20} /> Regulagem de portas e gavetas</li>
          <li><Icon name="check" size={20} /> Troca de dobradiças, corrediças e puxadores</li>
          <li><Icon name="check" size={20} /> Reparo de peças soltas, quebradas ou danificadas</li>
          <li><Icon name="check" size={20} /> Atendimento a imobiliárias, proprietários e inquilinos</li>
        </ul>
        <CtaButtons message={msgImobiliaria} size="md" />
      </div>
    </div>
  </section>

  <CtaBand />

  <section class="section section-soft" id="duvidas">
    <div class="container" style="max-width: 860px">
      <div class="section-head">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand title="Peça seu orçamento" text={`Atendimento pelo WhatsApp ou telefone ${site.phoneDisplay}.`} />
</Base>
